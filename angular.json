{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm"
  },
  "newProjectRoot": "projects",
  "projects": {
    "guest-portal": {
      "projectType": "application",
      "schematics": {},
      "root": "projects/guest-portal",
      "sourceRoot": "projects/guest-portal/src",
      "prefix": "guest",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "projects/guest-portal/src/main.ts",
            "tsConfig": "projects/guest-portal/tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/guest-portal/public"
              }
            ],
            "styles": ["projects/shared/src/styles.css", "projects/guest-portal/src/styles.css"]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "port": 4200,
            "proxyConfig": "proxy.conf.js"
          },
          "configurations": {
            "production": {
              "buildTarget": "guest-portal:build:production"
            },
            "development": {
              "buildTarget": "guest-portal:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test"
        }
      }
    },
    "staff-portal": {
      "projectType": "application",
      "schematics": {},
      "root": "projects/staff-portal",
      "sourceRoot": "projects/staff-portal/src",
      "prefix": "staff",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "projects/staff-portal/src/main.ts",
            "tsConfig": "projects/staff-portal/tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/staff-portal/public"
              }
            ],
            "styles": ["projects/shared/src/styles.css", "projects/staff-portal/src/styles.css"]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "port": 4201,
            "proxyConfig": "proxy.conf.js"
          },
          "configurations": {
            "production": {
              "buildTarget": "staff-portal:build:production"
            },
            "development": {
              "buildTarget": "staff-portal:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test"
        }
      }
    }
  }
}
