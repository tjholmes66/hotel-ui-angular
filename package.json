{
  "name": "hotel-ui-angular",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "npm run start:guest",
    "start:guest": "ng serve guest-portal",
    "start:staff": "ng serve staff-portal",
    "build": "npm run build:guest && npm run build:staff",
    "build:guest": "ng build guest-portal",
    "build:staff": "ng build staff-portal",
    "watch": "npm run watch:guest",
    "watch:guest": "ng build guest-portal --watch --configuration development",
    "watch:staff": "ng build staff-portal --watch --configuration development",
    "test": "npm run test:guest",
    "test:guest": "ng test guest-portal",
    "test:staff": "ng test staff-portal"
  },
  "private": true,
  "packageManager": "npm@12.0.2",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.5",
    "@angular/cli": "^22.2.5",
    "@angular/compiler-cli": "^22.2.0",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  }
}
